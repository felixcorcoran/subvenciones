---
/**
 * La página común: cabecera (tema, vista previa al compartir, fuentes,
 * visitas), la píldora de navegación y el pie. La usan la portada y la
 * ficha de cada convocatoria.
 */
import { Font } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	/** Datos estructurados (schema.org), si los hay */
	jsonLd?: object;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="theme-color" content="#FAF9F6" data-theme-color />
		<!-- Claro por defecto, como felixcorcoran.es; oscuro si se pidió al llegar
		     (?tema=oscuro, se recuerda y se quita de la barra) o se eligió antes -->
		<script is:inline>
			try {
				const url = new URL(location.href);
				const asked = url.searchParams.get('tema');
				if (asked === 'oscuro') localStorage.setItem('tema', 'oscuro');
				if (asked === 'claro') localStorage.removeItem('tema');
				if (asked) {
					url.searchParams.delete('tema');
					history.replaceState(null, '', url.pathname + url.search + url.hash);
				}
				if (asked === 'oscuro' || (!asked && localStorage.getItem('tema') === 'oscuro')) {
					document.documentElement.dataset.theme = 'dark';
					document.querySelector('[data-theme-color]')?.setAttribute('content', '#131211');
				}
			} catch {
				if (location.search.includes('tema=oscuro')) document.documentElement.dataset.theme = 'dark';
			}
		</script>
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Radar de subvenciones" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:image" content={imagen} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		<Font cssVariable="--font-sora" preload />
		<Analytics />
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>
