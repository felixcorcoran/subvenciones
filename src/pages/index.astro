---
import Base from '../layouts/Base.astro';
import '../styles/tarjetas.css';
import Asistente from '../components/Asistente.astro';
import datos from '../../datos/convocatorias.json';
import type { Datos } from '../lib/tipos';
import { estado, type Estado } from '../lib/estado';
import { hoyMadrid } from '../lib/fechas';
import { COMUNIDADES, SECTORES } from '../lib/lista';

const { actualizado, convocatorias } = datos as Datos;
// La web se construye cada día con los datos: la fecha de construcción es «hoy».
// Solo cuentan las ayudas (no premios ni otras); las sin leer aún, también
const hoy = hoyMadrid();
const cuenta = (e: Estado) => convocatorias.filter((c) => (!c.ia || c.ia.categoria === 'ayuda') && estado(c, hoy) === e).length;
const conFecha = cuenta('abierta');
const proximas = cuenta('proxima');
const sinFecha = cuenta('sin_fecha');
const fecha = actualizado
	? new Date(actualizado).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', timeZone: 'Europe/Madrid' })
	: '';

const title = 'Ayudas para tu negocio · Radar de subvenciones';
const description =
	'Cada mañana, las convocatorias de ayudas nuevas de toda España para autónomos y pymes. Dinos cómo es tu negocio y te decimos a cuáles puedes aspirar, y por qué.';

---

<Base title={title} description={description}>

		<main>
			<section class="intro">
				<p class="eyebrow">Radar de subvenciones</p>
				<h1>¿A qué ayudas puede optar tu negocio?</h1>
				<p class="lead">
					Cada mañana se recogen las convocatorias nuevas de toda España para autónomos y empresas, y se leen sus bases. Dinos cómo es tu
					negocio y te decimos a cuáles puedes aspirar, y por qué.
				</p>
				<p class="meta">
					<strong>{conFecha}</strong> ayudas con plazo abierto{proximas > 0 && <> · <strong>{proximas}</strong> abren pronto</>}
					{sinFecha > 0 && <> · <strong>{sinFecha}</strong> sin fecha de cierre confirmada</>}{fecha && <> · actualizado el {fecha}</>}
				</p>
				<div class="empezar">
					<button type="button" id="empezar" class="boton">
						Ver mis ayudas
						<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 6h9M7 2.5 10.5 6 7 9.5"></path></svg>
					</button>
					<div class="otras">
						<button type="button" id="anterior" class="enlace" hidden></button>
						<button type="button" id="todas" class="enlace">Mira todas las ayudas</button>
					</div>
					<!-- Los negocios guardados en este navegador (una gestoría, uno por cliente) -->
					<div id="negocios" class="negocios" hidden>
						<span class="negocios-titulo">Tus negocios:</span>
						<ul data-lista></ul>
					</div>
				</div>
				<!-- Si cambia el plazo de una guardada o desaparece (lo normal, que haya cerrado) -->
				<div id="novedades" class="novedades" role="status" hidden>
					<p class="novedades-titulo">Cambios en tus ayudas guardadas</p>
					<ul data-lista></ul>
					<p class="novedades-acciones">
						<button type="button" class="enlace" data-ver>Ver mis guardadas</button>
						<button type="button" class="enlace" data-visto>Entendido</button>
					</p>
				</div>
			</section>

			<Asistente />


			<p id="estado" class="estado" role="status" aria-live="polite"></p>

			<section id="resultado" class="resultado" hidden aria-labelledby="resultado-titulo">
				<div class="resultado-cabeza">
					<div id="tu-negocio" class="tu-negocio" hidden>
						<p class="eyebrow">Tu negocio</p>
						<ul id="respuestas"></ul>
						<button type="button" id="cambiar" class="enlace">Cambiar respuestas</button>
						<button type="button" id="compartir" class="enlace">Copiar el enlace a estos resultados</button>
						<a href="#avisos" class="enlace">Recibir las nuevas por email</a>
						<button type="button" id="guardar-negocio" class="enlace">Guardar este negocio</button>
						<form id="form-negocio" class="form-negocio" hidden>
							<label for="nombre-negocio">Nombre para este negocio</label>
							<input id="nombre-negocio" maxlength="60" autocomplete="off" placeholder="Por ejemplo: Bar Pepe" required />
							<button type="submit" class="boton boton--pequeno">Guardar</button>
						</form>
						<label class="cambiar-negocio" id="cambiar-negocio" hidden>
							<span>Ver otro negocio:</span>
							<select data-select></select>
						</label>
					</div>
					<h2 id="resultado-titulo"></h2>
					<p id="resumen" class="resumen"></p>
					<!-- Solo en «Todas las ayudas»: buscar y acotar en el navegador, sobre lo ya descargado -->
					<div id="filtros" class="filtros" role="search" hidden>
						<label class="sr-only" for="buscar">Buscar entre las ayudas</label>
						<input id="buscar" type="search" placeholder="Buscar: comercio, alquiler, Cabra…" autocomplete="off" enterkeyhint="search" />
						<label class="sr-only" for="filtro-comunidad">Comunidad</label>
						<select id="filtro-comunidad">
							<option value="">Toda España</option>
							{COMUNIDADES.map((c) => <option value={c.codigo}>{c.nombre}</option>)}
						</select>
						<label class="pronto-filtro"><input type="checkbox" id="filtro-pronto" /> Cierran en 15 días o menos</label>
					</div>
					<div class="casillas">
						<label class="premios" id="guardadas-filtro" hidden><input type="checkbox" id="solo-guardadas" /> <span>Solo mis guardadas</span></label>
						<label class="premios"><input type="checkbox" id="ver-premios" /> Mostrar también premios y concursos</label>
						<button type="button" id="calendario-guardadas" class="enlace" hidden>Añadir mis guardadas al calendario</button>
					</div>
				</div>
				<div id="grupos"></div>
				<!-- Los avisos por email (alertas.felixcorcoran.es): con las respuestas que ya ha dado, solo falta el email -->
				<section id="avisos" class="avisos" hidden aria-labelledby="avisos-titulo">
					<p class="eyebrow">Avisos por email</p>
					<h3 id="avisos-titulo">¿Te avisamos cuando salgan ayudas nuevas para tu negocio?</h3>
					<p class="avisos-texto">
						Cada mañana miramos las convocatorias nuevas y, si alguna encaja con lo que nos has dicho, te llega un correo (o un resumen a la semana, si lo prefieres). Si cambia el plazo de una que te enviamos, también te lo decimos. Gratis, sin cuenta y con baja en un clic.
					</p>
					<form id="avisos-form" novalidate>
						<div class="avisos-fila">
							<label class="sr-only" for="avisos-email">Tu email</label>
							<input id="avisos-email" type="email" autocomplete="email" inputmode="email" placeholder="Tu email" required />
							<button type="submit" class="boton">Avisarme <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 6h9M7 2.5 10.5 6 7 9.5"></path></svg></button>
						</div>
						<fieldset class="avisos-frecuencia">
							<legend class="sr-only">Cada cuánto</legend>
							<label><input type="radio" name="avisos-frecuencia" value="diaria" checked /> Cada día que haya algo</label>
							<label><input type="radio" name="avisos-frecuencia" value="semanal" /> Un resumen a la semana</label>
						</fieldset>
						<!-- Solo si tiene guardadas: sus plazos, también por email (sin marcar: lo elige) -->
						<label class="avisos-acepto" id="avisos-seguir" hidden>
							<input type="checkbox" id="avisos-seguidas" />
							<span data-texto>Avísame también si cambia el plazo de mis ayudas guardadas</span>
						</label>
						<label class="avisos-acepto">
							<input type="checkbox" id="avisos-acepto" />
							<span>He leído la <a href="https://alertas.felixcorcoran.es/privacidad" target="_blank" rel="noopener" data-site-link>política de privacidad</a>: mi email y estas respuestas solo se usan para enviarme los avisos.</span>
						</label>
						<p id="avisos-estado" class="avisos-estado" role="status" aria-live="polite"></p>
					</form>
					<!-- Sin email: los plazos de su comunidad en el calendario, o su RSS -->
					<p id="avisos-sin-email" class="avisos-sin-email" hidden>
						¿Prefieres no dar tu email? <a data-webcal>Los plazos de <span data-comunidad></span> en tu calendario</a>{' · '}
						<a data-google target="_blank" rel="noopener">en Google Calendar ↗</a>{' · '}<a data-rss>RSS</a>
					</p>
				</section>
				<nav class="explorar" aria-labelledby="explorar-titulo">
					<p id="explorar-titulo" class="eyebrow">Ayudas por comunidad</p>
					<ul>{COMUNIDADES.map((c) => <li><a href={`/comunidades/${c.slug}`}>{c.nombre}</a></li>)}</ul>
					<p class="eyebrow">Ayudas por sector</p>
					<ul>{SECTORES.map((s) => <li><a href={`/sectores/${s.slug}`}>{s.nombre}</a></li>)}</ul>
				</nav>
				<p class="aviso-fuente">
					Es una orientación: antes de pedir una ayuda, lee su convocatoria oficial, que es la que vale. Datos del{' '}
					<a href="https://www.infosubvenciones.es/bdnstrans/GE/es/convocatorias" target="_blank" rel="noopener">Sistema Nacional de Publicidad de Subvenciones</a>; resúmenes hechos con IA a partir de las bases.
				</p>
			</section>

		</main>

		<script>
			import { cierre, encaje, fechaLarga, municipioDe, type Encaje, type Perfil } from '../lib/encaje';
			import { enLista, estado as estadoDe, plazoSinFecha, sinComprobarDesde, textoPlazo } from '../lib/estado';
			import { hoyMadrid } from '../lib/fechas';
			import { COMUNIDADES, cercania, coincide, deComunidad, diasHasta, esEstatal, porCierre, textoMotivo, titularDe } from '../lib/lista';
			import type { ConvocatoriaWeb } from '../lib/tipos';
			import type { Detalles } from '../lib/web';
			import {
				alternarGuardada,
				borrarNegocio,
				cambiosGuardadas,
				contarGuardada,
				esNueva,
				guardadas,
				guardarNegocio,
				negocios,
				registrarVisita,
				verCambios,
				type Negocio,
			} from '../lib/visitas';
			import { esFinalidad, nombreFinalidad, sirvePara } from '../lib/finalidades';
			import { calendarioIcs } from '../lib/calendario';

			const estado = document.querySelector<HTMLParagraphElement>('#estado')!;
			const resultado = document.querySelector<HTMLElement>('#resultado')!;
			const grupos = document.querySelector<HTMLDivElement>('#grupos')!;
			const verPremios = document.querySelector<HTMLInputElement>('#ver-premios')!;
			const avisos = document.querySelector<HTMLElement>('#avisos')!;

			const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string) => {
				const node = document.createElement(tag);
				if (className) node.className = className;
				if (text) node.textContent = text;
				return node;
			};

			let cache: ConvocatoriaWeb[] | null = null;
			async function cargar(): Promise<ConvocatoriaWeb[]> {
				if (cache) return cache;
				estado.textContent = 'Cargando las convocatorias…';
				const res = await fetch('/convocatorias.json');
				const data = (await res.json()) as { convocatorias: ConvocatoriaWeb[] };
				estado.textContent = '';
				return (cache = data.convocatorias);
			}

			// Requisitos y gastos de todas, en una sola petición; si falla, se vuelve a pedir la próxima vez
			let pedidaDetalles: Promise<Detalles> | null = null;
			const detalles = (): Promise<Detalles> =>
				(pedidaDetalles ??= fetch('/detalles.json')
					.then((r) => {
						if (!r.ok) throw new Error(String(r.status));
						return r.json() as Promise<Detalles>;
					})
					.catch((): Detalles => {
						pedidaDetalles = null;
						return {};
					}));

			const euros = (n: number) => n.toLocaleString('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });

			// El día en hora de Madrid: con la fecha UTC, de madrugada se usaba el día anterior
			const hoy = () => hoyMadrid();
			// Para marcar las que han entrado en el radar desde la visita anterior
			const visitaAnterior = registrarVisita(hoy());

			function plazo(c: ConvocatoriaWeb): { texto: string; pronto: boolean } {
				const dias = diasHasta(c, hoy());
				return { texto: textoPlazo(c, hoy()), pronto: dias !== null && dias <= 7 };
			}

			function tarjeta(c: ConvocatoriaWeb, e: Encaje | null) {
				const item = el('li', `ayuda ayuda--${e?.estado ?? 'neutra'}`);
				const cabeza = el('div', 'ayuda-cabeza');
				const organo = [c.organo.nivel3, municipioDe(c) ?? c.organo.nivel2].filter((v, i, a) => v && a.indexOf(v) === i).join(' · ');
				// El título lleva a la ficha de la convocatoria (/ayudas/<código>)
				const titulo = el('h3');
				const ficha = el('a', '', titularDe(c));
				ficha.href = `/ayudas/${c.codigo}`;
				titulo.append(ficha);
				// Guardarla en este navegador, para seguirla (filtro «Solo mis guardadas»)
				const guardar = el('button', 'guardar');
				guardar.type = 'button';
				const pintarGuardar = (si: boolean) => {
					guardar.textContent = si ? '★ Guardada' : '☆ Guardar';
					guardar.setAttribute('aria-pressed', String(si));
					guardar.setAttribute('aria-label', `${si ? 'Quitar de guardadas' : 'Guardar'}: ${titularDe(c)}`);
				};
				pintarGuardar(guardadas().has(c.codigo));
				guardar.addEventListener('click', () => {
					const ahora = alternarGuardada(c);
					pintarGuardar(ahora);
					if (ahora) contarGuardada(c.codigo);
					contarGuardadas();
				});
				cabeza.append(guardar, el('p', 'ayuda-organo', organo), titulo);
				item.append(cabeza);

				const datosClave = el('ul', 'ayuda-datos');
				const p = plazo(c);
				if (esNueva(c, visitaAnterior)) datosClave.append(el('li', 'nueva', 'Nueva'));
				if (e && e.estado !== 'no' && sirvePara(c.ia?.finalidades, ultima.finalidad)) datosClave.append(el('li', 'para-ti', `Para ${nombreFinalidad(ultima.finalidad!).toLowerCase()}`));
				const plazoLi = el('li', p.pronto ? 'pronto' : '', p.texto);
				datosClave.append(plazoLi);
				// Con el plazo dicho con palabras, que quede claro que no hay fecha confirmada
				if (!cierre(c) && plazoSinFecha(c)) datosClave.append(el('li', 'sin-comprobar', 'Sin fecha de cierre confirmada'));
				const desde = sinComprobarDesde(c, hoy());
				if (desde) datosClave.append(el('li', 'sin-comprobar', `Sin comprobar en la BDNS desde el ${fechaLarga(desde)}`));
				// Una cifra corta; el importe explicado va en «Requisitos y detalles»
				if (c.ia?.importeMaximo) datosClave.append(el('li', '', `Hasta ${euros(c.ia.importeMaximo)}`));
				else if (c.presupuesto) datosClave.append(el('li', '', `Presupuesto total: ${euros(c.presupuesto)}`));
				item.append(datosClave);

				if (e) {
					const motivos = el('ul', 'motivos');
					const municipio = municipioDe(c);
					for (const m of e.motivos) motivos.append(el('li', `motivo motivo--${m.tipo}`, textoMotivo(m, municipio)));
					item.append(motivos);
				}

				const mas = el('details', 'ayuda-mas');
				mas.append(el('summary', '', 'Requisitos y detalles'));
				if (c.ia) {
					// Con titular corto, el resumen completo va aquí
					if (c.ia.titular) mas.append(el('h4', '', 'Qué financia'), el('p', '', c.ia.resumen));
					mas.append(el('h4', '', 'Para quién'), el('p', '', c.ia.paraQuien));
					// Requisitos y gastos llegan aparte (detalles.json) al abrir el primero
					const hueco = el('div', 'ayuda-detalle');
					mas.append(hueco);
					mas.addEventListener(
						'toggle',
						async () => {
							if (!mas.open || hueco.dataset.cargado) return;
							hueco.dataset.cargado = '1';
							const d = (await detalles())[c.codigo];
							if (!d) {
								// Sin conexión o sin datos: se dice y se reintenta al volver a abrir
								delete hueco.dataset.cargado;
								hueco.replaceChildren(el('p', '', 'No hemos podido cargar los requisitos: míralos en la ficha completa.'));
								return;
							}
							hueco.replaceChildren();
							const lista = (titulo: string, items: string[]) => {
								if (!items.length) return;
								const ul = el('ul');
								for (const r of items) ul.append(el('li', '', r));
								hueco.append(el('h4', '', titulo), ul);
							};
							lista('Requisitos', d.requisitos);
							lista('En qué se puede gastar', d.gastos);
						},
					);
					if (c.ia.importe) mas.append(el('h4', '', 'Importe'), el('p', '', c.ia.importe));
					if (c.ia.plazo && !c.iaRevisar) mas.append(el('h4', '', 'Plazo'), el('p', '', c.ia.plazo));
				} else {
					mas.append(el('p', '', 'Aún no hemos leído sus bases. Mira los requisitos en la convocatoria oficial.'));
				}
				mas.append(el('p', 'oficial', `Título oficial: ${c.titulo}`));
				const enlaces = el('p', 'enlaces');
				const enlace = (href: string, texto: string) => {
					const a = el('a', '', `${texto} ↗`);
					a.href = href;
					a.target = '_blank';
					a.rel = 'noopener';
					enlaces.append(a);
				};
				const propio = (href: string, texto: string, descarga?: string) => {
					const a = el('a', '', texto);
					a.href = href;
					if (descarga) a.download = descarga;
					enlaces.append(a);
				};
				propio(`/ayudas/${c.codigo}`, 'Ficha completa');
				if (cierre(c) && (diasHasta(c, hoy()) ?? -1) >= 0) propio(`/ayudas/${c.codigo}.ics`, 'Añadir el plazo al calendario', `plazo-${c.codigo}.ics`);
				enlace(c.enlace, 'Convocatoria oficial (BDNS)');
				if (c.bases) enlace(c.bases, 'Bases');
				if (c.sede) enlace(c.sede, 'Dónde se solicita');
				mas.append(enlaces);
				item.append(mas);
				return item;
			}

			/** Lo que se está viendo: el negocio (o ninguno, en «Todas las ayudas») y para qué busca la ayuda */
			let ultima: { perfil: Perfil | null; finalidad: string | null } = { perfil: null, finalidad: null };

			const filtros = document.querySelector<HTMLElement>('#filtros')!;
			const buscar = document.querySelector<HTMLInputElement>('#buscar')!;
			const filtroComunidad = document.querySelector<HTMLSelectElement>('#filtro-comunidad')!;
			const filtroPronto = document.querySelector<HTMLInputElement>('#filtro-pronto')!;
			const soloGuardadas = document.querySelector<HTMLInputElement>('#solo-guardadas')!;
			const calendarioGuardadas = document.querySelector<HTMLButtonElement>('#calendario-guardadas')!;
			// Los plazos de las guardadas, en un .ics que se descarga (se genera aquí, no sale del navegador)
			calendarioGuardadas.addEventListener('click', () => {
				const mias = guardadas();
				const lista = (cache ?? []).filter((c) => mias.has(c.codigo));
				const ics = calendarioIcs(lista, (c) => `${location.origin}/ayudas/${c.codigo}`, 'Mis ayudas guardadas');
				const a = el('a');
				a.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
				a.download = 'ayudas-guardadas.ics';
				document.body.append(a);
				a.click();
				a.remove();
				setTimeout(() => URL.revokeObjectURL(a.href), 1000);
			});
			const guardadasFiltro = document.querySelector<HTMLElement>('#guardadas-filtro')!;
			/** El contador de «Solo mis guardadas»: solo se ve si hay alguna (o si está marcado) */
			function contarGuardadas() {
				const n = cache ? cache.filter((c) => guardadas().has(c.codigo)).length : 0;
				guardadasFiltro.querySelector('span')!.textContent = `Solo mis guardadas (${n})`;
				guardadasFiltro.hidden = n === 0 && !soloGuardadas.checked;
				// En los avisos, seguir también sus plazos por email
				const todas = guardadas().size;
				const seguir = document.querySelector<HTMLElement>('#avisos-seguir')!;
				seguir.hidden = todas === 0;
				seguir.querySelector('[data-texto]')!.textContent =
					todas === 1 ? 'Avísame también si cambia el plazo de mi ayuda guardada' : `Avísame también si cambia el plazo de mis ${todas} ayudas guardadas`;
			}
			const titulo = document.querySelector<HTMLElement>('#resultado-titulo')!;
			const resumen = document.querySelector<HTMLElement>('#resumen')!;
			const avisosTitulo = document.querySelector<HTMLElement>('#avisos-titulo')!;

			/** Con los filtros de «Todas las ayudas» */
			function filtradas(lista: ConvocatoriaWeb[]): ConvocatoriaWeb[] {
				const comunidad = filtroComunidad.value;
				return lista.filter((c) => {
					if (!coincide(c, buscar.value)) return false;
					// Una comunidad: las suyas y las de toda España
					if (comunidad && !deComunidad(c, comunidad) && !esEstatal(c)) return false;
					if (filtroPronto.checked) {
						const dias = diasHasta(c, hoy());
						if (dias === null || dias > 15) return false;
					}
					return true;
				});
			}

			function pintar() {
				if (!cache) return;
				const perfil = ultima.perfil;
				// Fuera de la lista: las cerradas desde la última construcción y las «por verificar»
				const mias = guardadas();
				const visibles = cache.filter(
					(c) =>
						(verPremios.checked || !c.ia || c.ia.categoria === 'ayuda') &&
						enLista(estadoDe(c, hoy())) &&
						(!soloGuardadas.checked || mias.has(c.codigo)),
				);
				const nuevas = visibles.filter((c) => esNueva(c, visitaAnterior)).length;
				const yNuevas = nuevas ? ` · ${nuevas === 1 ? '1 nueva' : `${nuevas} nuevas`} desde tu última visita` : '';
				contarGuardadas();
				// Solo si alguna tiene fecha de cierre: si no, el calendario saldría vacío
				calendarioGuardadas.hidden = !soloGuardadas.checked || !visibles.some((c) => cierre(c));
				grupos.replaceChildren();
				filtros.hidden = Boolean(perfil);

				if (!perfil) {
					const lista = filtradas(visibles).sort(porCierre);
					titulo.textContent = 'Todas las ayudas';
					const filtrando = lista.length !== visibles.length;
					resumen.textContent = filtrando
						? `${lista.length} de ${visibles.length} convocatorias, las que cierran antes primero${yNuevas}`
						: `${visibles.length} convocatorias, las que cierran antes primero${yNuevas}`;
					if (!lista.length) grupos.append(el('p', 'grupo-texto vacio', 'Ninguna con esos filtros. Prueba con otras palabras o con toda España.'));
					else {
						const ol = el('ol', 'lista');
						for (const c of lista) ol.append(tarjeta(c, null));
						grupos.append(ol);
					}
				} else {
					// Las que sirven para lo que busca, primero en cada grupo (sin quitar ninguna)
					const evaluadas = visibles.map((c) => ({
						c,
						e: encaje(c, perfil, hoy()),
						cerca: cercania(c, perfil, municipioDe(c)),
						para: sirvePara(c.ia?.finalidades, ultima.finalidad) ? 0 : 1,
					}));
					const de = (s: Encaje['estado']) => evaluadas.filter((x) => x.e.estado === s);
					const si = de('si').sort((a, b) => a.para - b.para || porCierre(a.c, b.c));
					// «Revisa», primero las más cercanas al negocio: su municipio, su provincia, su comunidad, toda España
					const revisa = de('revisa').sort((a, b) => a.para - b.para || a.cerca - b.cerca || porCierre(a.c, b.c));
					const no = de('no').sort((a, b) => porCierre(a.c, b.c));
					titulo.textContent = si.length
						? 'Las ayudas para tu negocio'
						: revisa.length
							? 'Ninguna encaja del todo, pero hay ayudas que revisar'
							: 'Ahora mismo no hay ayudas que encajen';
					const paraTi = [...si, ...revisa].filter((x) => x.para === 0).length;
					const yParaTi = ultima.finalidad && paraTi ? ` · ${paraTi} para ${nombreFinalidad(ultima.finalidad).toLowerCase()}` : '';
					resumen.textContent = `${si.length} puedes pedirlas · ${revisa.length} para revisar · ${no.length} no encajan${yParaTi}${yNuevas}`;

					const grupo = (nombre: string, texto: string, lista: typeof evaluadas, clase: string, plegado = false) => {
						if (!lista.length) return;
						const ol = el('ol', 'lista');
						for (const { c, e } of lista) ol.append(tarjeta(c, e));
						if (plegado) {
							const d = el('details', `grupo grupo--${clase}`);
							d.append(el('summary', '', `${nombre} (${lista.length})`), el('p', 'grupo-texto', texto), ol);
							grupos.append(d);
						} else {
							const s = el('section', `grupo grupo--${clase}`);
							s.append(el('h3', 'grupo-titulo', `${nombre} (${lista.length})`), el('p', 'grupo-texto', texto), ol);
							grupos.append(s);
						}
					};
					grupo('Puedes pedirlas', 'Encajan con lo que nos has dicho. Aun así, lee los requisitos antes de pedirlas.', si, 'si');
					grupo(
						'Revisa los detalles',
						'Podrían encajar, pero falta algún dato o hay que comprobar algo en las bases. Primero, las más cercanas a tu negocio.',
						revisa,
						'revisa',
					);
					grupo('No encajan', 'Por qué no, en cada una.', no, 'no', true);
					// Sin ninguna que se pueda pedir ya, lo útil es que le avisemos: el recuadro, arriba
					if (!si.length) {
						grupos.before(avisos);
						avisosTitulo.textContent = 'Te avisamos en cuanto salga una ayuda para tu negocio';
					} else {
						grupos.after(avisos);
						avisosTitulo.textContent = '¿Te avisamos cuando salgan ayudas nuevas para tu negocio?';
					}
				}
				// Los avisos, solo con un negocio (no en «todas las ayudas»)
				avisos.hidden = !perfil;
				resultado.hidden = false;
			}

			let espera: ReturnType<typeof setTimeout> | undefined;
			buscar.addEventListener('input', () => {
				clearTimeout(espera);
				espera = setTimeout(pintar, 150);
			});
			filtroComunidad.addEventListener('change', pintar);
			filtroPronto.addEventListener('change', pintar);

			// Apuntarse a los avisos con las respuestas del asistente: la misma API que
			// alertas.felixcorcoran.es, que manda el correo para confirmar
			const ALERTAS = import.meta.env.PUBLIC_ALERTAS_API ?? 'https://alertas.felixcorcoran.es';
			const avisosForm = document.querySelector<HTMLFormElement>('#avisos-form')!;
			const avisosEmail = document.querySelector<HTMLInputElement>('#avisos-email')!;
			const avisosAcepto = document.querySelector<HTMLInputElement>('#avisos-acepto')!;
			const avisosEstado = document.querySelector<HTMLElement>('#avisos-estado')!;
			avisosForm.addEventListener('submit', async (e) => {
				e.preventDefault();
				const email = avisosEmail.value.trim();
				const perfil = ultima.perfil;
				avisosEstado.className = 'avisos-estado avisos-estado--error';
				if (!perfil) return;
				if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return void (avisosEstado.textContent = 'Escribe un email válido.');
				if (!avisosAcepto.checked) return void (avisosEstado.textContent = 'Para apuntarte, marca que has leído la política de privacidad.');

				const frecuencia = avisosForm.querySelector<HTMLInputElement>('input[name="avisos-frecuencia"]:checked')?.value ?? 'diaria';
				const seguidas = document.querySelector<HTMLInputElement>('#avisos-seguidas')!.checked ? [...guardadas()].slice(0, 50) : [];
				const boton = avisosForm.querySelector<HTMLButtonElement>('button')!;
				boton.disabled = true;
				avisosEstado.className = 'avisos-estado';
				avisosEstado.textContent = 'Enviando…';
				try {
					const r = await fetch(`${ALERTAS}/api/suscripciones`, {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ email, perfil, acepto: true, frecuencia, seguidas }),
					});
					if (r.status === 429) throw new Error('Demasiados intentos seguidos. Prueba de nuevo en unos minutos.');
					if (r.status === 400) throw new Error('Revisa el email: no parece válido.');
					if (!r.ok) throw new Error('No hemos podido apuntarte. Inténtalo de nuevo en un momento.');
					avisosForm.replaceChildren(
						el('p', 'avisos-ok', `Revisa tu correo: te hemos escrito a ${email}. Pulsa el enlace para confirmar y empezar a recibir los avisos.`),
						el('p', 'avisos-texto', '¿No llega? Mira en spam o promociones. Sin confirmar no te enviaremos nada.'),
					);
				} catch (error) {
					avisosEstado.className = 'avisos-estado avisos-estado--error';
					avisosEstado.textContent =
						error instanceof TypeError ? 'No hemos podido conectar. Inténtalo de nuevo en un momento.' : (error as Error).message;
				} finally {
					boton.disabled = false;
				}
			});

			// El asistente (Asistente.astro): se abre con «Ver mis ayudas» y avisa al terminar
			import provincias from '../data/provincias.json';
			import { nombreSeccion } from '../lib/sectores';
			const asistente = document.querySelector<HTMLElement>('#asistente')!;
			const CLAVE = 'perfil-subvenciones';
			type Guardado = Perfil & { comunidad?: string; finalidad?: string | null };
			const leerGuardado = (): Guardado | null => {
				try {
					return JSON.parse(localStorage.getItem(CLAVE) ?? 'null') as Guardado | null;
				} catch {
					return null;
				}
			};

			const FORMAS = { autonomo: 'Autónomo o autónoma', sociedad: 'Empresa (sociedad)', emprender: 'Aún no ha empezado' };
			const PLANTILLA: Record<number, string> = { 0: 'Solo yo', 1: '1 a 9 personas', 10: '10 a 49 personas', 50: '50 a 249 personas', 250: '250 o más' };
			const ANTIGUEDAD = { nada: '', menos1: 'Menos de un año', '1a3': 'De 1 a 3 años', mas3: 'Más de 3 años' };
			const respuestas = (p: Perfil, finalidad: string | null = null) =>
				[
					provincias.find((x) => x.codigo === p.provincia)?.nombre ?? '',
					p.municipio,
					FORMAS[p.forma],
					p.forma === 'emprender' ? '' : PLANTILLA[p.empleados],
					ANTIGUEDAD[p.antiguedad],
					p.sector ? nombreSeccion(p.sector) : 'Sector sin indicar',
					finalidad ? `Para: ${nombreFinalidad(finalidad).toLowerCase()}` : '',
				].filter(Boolean);

			// Si ya respondió antes en este navegador, puede ir directo
			const anterior = document.querySelector<HTMLButtonElement>('#anterior')!;
			const previo = leerGuardado();
			if (previo?.provincia) {
				anterior.hidden = false;
				anterior.textContent = `Usa tus respuestas de antes · ${respuestas(previo).slice(0, 2).join(' · ')}`;
			}

			const abrir = (detalle: object = {}) => {
				resultado.hidden = true;
				document.querySelector('.intro')!.classList.add('empezada');
				document.dispatchEvent(new CustomEvent('empezar-asistente', { detail: detalle }));
				// Arriba del todo: el título y la primera pregunta, sin saltos
				window.scrollTo({ top: 0, behavior: 'instant' });
			};
			document.querySelector('#empezar')!.addEventListener('click', () => abrir());
			// «Atrás» desde la primera pregunta: a los resultados si los había, si no a la portada
			document.addEventListener('cerrar-asistente', () => {
				if (ultima.perfil || !document.querySelector<HTMLElement>('#tu-negocio')!.hidden) {
					resultado.hidden = false;
					window.scrollTo({ top: 0, behavior: 'instant' });
					return;
				}
				document.querySelector('.intro')!.classList.remove('empezada');
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});
			document.querySelector('#cambiar')!.addEventListener('click', () => abrir({ perfil: leerGuardado() ?? {} }));

			// Los resultados, siempre desde arriba: el título, el negocio y las ayudas.
			// La dirección no cambia (recargar vuelve a la portada, con «Usa tus
			// respuestas de antes»); el enlace para compartir lleva las respuestas.
			async function verAyudas(perfil: Perfil, finalidad: string | null = null) {
				finalidad = esFinalidad(finalidad) ? finalidad : null;
				asistente.hidden = true;
				document.querySelector('.intro')!.classList.add('empezada');
				const tu = document.querySelector<HTMLElement>('#tu-negocio')!;
				tu.hidden = false;
				document.querySelector('#respuestas')!.replaceChildren(...respuestas(perfil, finalidad).map((t) => el('li', '', t)));
				// La alternativa sin email: el calendario y el RSS de su comunidad
				const comunidad = COMUNIDADES.find((k) => k.codigo === provincias.find((x) => x.codigo === perfil.provincia)?.codigoComunidad);
				const sinEmail = document.querySelector<HTMLElement>('#avisos-sin-email')!;
				if (comunidad) {
					const webcal = `webcal://${location.host}/comunidades/${comunidad.slug}.ics`;
					sinEmail.querySelector('[data-comunidad]')!.textContent = comunidad.nombre;
					sinEmail.querySelector<HTMLAnchorElement>('[data-webcal]')!.href = webcal;
					sinEmail.querySelector<HTMLAnchorElement>('[data-google]')!.href = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcal)}`;
					sinEmail.querySelector<HTMLAnchorElement>('[data-rss]')!.href = `/comunidades/${comunidad.slug}.xml`;
				}
				sinEmail.hidden = !comunidad;
				await cargar();
				ultima = { perfil, finalidad };
				pintarNegocios();
				pintar();
				window.scrollTo({ top: 0, behavior: 'instant' });
				// Para «Usa tus respuestas de antes» al volver (también si llegó por un enlace)
				try {
					const comunidad = provincias.find((x) => x.codigo === perfil.provincia)?.codigoComunidad;
					localStorage.setItem(CLAVE, JSON.stringify({ ...perfil, comunidad, finalidad }));
				} catch {}
			}
			document.addEventListener('perfil-listo', (e) => {
				const { perfil, finalidad } = (e as CustomEvent<{ perfil: Perfil; finalidad: string | null }>).detail;
				verAyudas(perfil, finalidad);
			});
			// Solo el perfil del encaje: la finalidad no va a alertas ni a la comparación
			const soloPerfil = (g: Guardado): Perfil => ({
				provincia: g.provincia,
				municipio: g.municipio ?? '',
				forma: g.forma,
				empleados: g.empleados,
				antiguedad: g.antiguedad,
				sector: g.sector ?? '',
			});
			anterior.addEventListener('click', () => {
				const p = leerGuardado();
				if (p) verAyudas(soloPerfil(p), p.finalidad ?? null);
			});

			document.querySelector('#todas')!.addEventListener('click', async () => {
				asistente.hidden = true;
				document.querySelector<HTMLElement>('#tu-negocio')!.hidden = true;
				document.querySelector('.intro')!.classList.add('empezada');
				await cargar();
				ultima = { perfil: null, finalidad: null };
				pintar();
				window.scrollTo({ top: 0, behavior: 'instant' });
			});

			verPremios.addEventListener('change', pintar);
			soloGuardadas.addEventListener('change', pintar);

			// El perfil en la dirección: ?provincia=ES617&municipio=Marbella&forma=autonomo…
			function aParametros(p: Perfil): string {
				const q = new URLSearchParams({ provincia: p.provincia, forma: p.forma, sector: p.sector });
				if (p.municipio) q.set('municipio', p.municipio);
				if (p.forma !== 'emprender') {
					q.set('empleados', String(p.empleados));
					q.set('antiguedad', p.antiguedad);
				}
				if (ultima.finalidad) q.set('para', ultima.finalidad);
				return q.toString();
			}
			function deParametros(q: URLSearchParams): Perfil | null {
				const provincia = q.get('provincia') ?? '';
				const forma = q.get('forma') as Perfil['forma'] | null;
				if (!provincias.some((x) => x.codigo === provincia) || !forma || !(forma in FORMAS)) return null;
				const empleados = Number(q.get('empleados') ?? 0);
				const antiguedad = (q.get('antiguedad') ?? '1a3') as Perfil['antiguedad'];
				return {
					provincia,
					municipio: q.get('municipio') ?? '',
					forma,
					empleados: forma === 'emprender' || !(empleados in PLANTILLA) ? 0 : empleados,
					antiguedad: forma === 'emprender' ? 'nada' : antiguedad in ANTIGUEDAD ? antiguedad : '1a3',
					sector: (q.get('sector') ?? '').slice(0, 1).toUpperCase(),
				};
			}

			// Los negocios guardados: en la portada, para ir directo; en los resultados, para cambiar de uno a otro
			const negociosCaja = document.querySelector<HTMLElement>('#negocios')!;
			const cambiarNegocio = document.querySelector<HTMLElement>('#cambiar-negocio')!;
			const selectNegocio = cambiarNegocio.querySelector<HTMLSelectElement>('[data-select]')!;
			const verNegocio = (n: Negocio) => verAyudas(soloPerfil(n.perfil), n.finalidad ?? null);
			function pintarNegocios() {
				const lista = negocios();
				const ul = negociosCaja.querySelector('[data-lista]')!;
				ul.replaceChildren(
					...lista.map((n) => {
						const li = el('li');
						const ir = el('button', 'enlace', n.nombre);
						ir.type = 'button';
						ir.addEventListener('click', () => verNegocio(n));
						const quitar = el('button', 'quitar', '×');
						quitar.type = 'button';
						quitar.setAttribute('aria-label', `Borrar el negocio «${n.nombre}»`);
						quitar.addEventListener('click', () => {
							borrarNegocio(n.nombre);
							pintarNegocios();
						});
						li.append(ir, quitar);
						return li;
					}),
				);
				negociosCaja.hidden = lista.length === 0;
				// En los resultados: los demás negocios, para cambiar
				selectNegocio.replaceChildren(
					Object.assign(el('option', '', 'Elige…'), { value: '' }),
					...lista.map((n, i) => Object.assign(el('option', '', n.nombre), { value: String(i) })),
				);
				cambiarNegocio.hidden = lista.length === 0;
			}
			selectNegocio.addEventListener('change', () => {
				const n = negocios()[Number(selectNegocio.value)];
				if (selectNegocio.value !== '' && n) verNegocio(n);
			});
			const formNegocio = document.querySelector<HTMLFormElement>('#form-negocio')!;
			const nombreNegocio = document.querySelector<HTMLInputElement>('#nombre-negocio')!;
			const botonGuardarNegocio = document.querySelector<HTMLButtonElement>('#guardar-negocio')!;
			botonGuardarNegocio.addEventListener('click', () => {
				formNegocio.hidden = false;
				nombreNegocio.focus();
			});
			formNegocio.addEventListener('submit', (e) => {
				e.preventDefault();
				if (!ultima.perfil || !nombreNegocio.value.trim()) return;
				guardarNegocio({ nombre: nombreNegocio.value, perfil: ultima.perfil, finalidad: ultima.finalidad });
				formNegocio.hidden = true;
				nombreNegocio.value = '';
				botonGuardarNegocio.textContent = 'Negocio guardado';
				setTimeout(() => (botonGuardarNegocio.textContent = 'Guardar este negocio'), 2500);
				pintarNegocios();
			});
			pintarNegocios();

			// Cambios en las guardadas desde la última vez: se miran al entrar (solo si hay alguna)
			const novedades = document.querySelector<HTMLElement>('#novedades')!;
			async function mirarGuardadas() {
				if (guardadas().size === 0) return;
				const lista = await cargar().catch(() => null);
				if (!lista) return;
				const cambios = cambiosGuardadas(lista);
				if (!cambios.length) return;
				novedades.querySelector('[data-lista]')!.replaceChildren(
					...cambios.map((x) => {
						const li = el('li');
						if (x.tipo === 'fuera') {
							// Su ficha dice que ha cerrado (o, pasados unos meses, la página de no encontrada lo explica)
							const a = el('a', '', `La ayuda ${x.codigo}`);
							a.href = `/ayudas/${x.codigo}`;
							li.append(a, ' ya no está en el radar: lo normal es que haya cerrado.');
						}
						else {
							const a = el('a', '', titularDe(x.c!));
							a.href = `/ayudas/${x.codigo}`;
							li.append(a, `: el plazo ${x.ahora ? `ahora termina el ${fechaLarga(x.ahora)}` : 'ya no tiene fecha de cierre confirmada'}${x.antes ? ` (antes, el ${fechaLarga(x.antes)})` : ''}.`);
						}
						return li;
					}),
				);
				estado.textContent = '';
				novedades.hidden = false;
			}
			novedades.querySelector('[data-visto]')!.addEventListener('click', () => {
				if (cache) verCambios(cache);
				novedades.hidden = true;
			});
			novedades.querySelector('[data-ver]')!.addEventListener('click', async () => {
				if (cache) verCambios(cache);
				novedades.hidden = true;
				soloGuardadas.checked = true;
				document.querySelector<HTMLButtonElement>('#todas')!.click();
			});

			const compartir = document.querySelector<HTMLButtonElement>('#compartir')!;
			compartir.addEventListener('click', async () => {
				const url = ultima.perfil ? `${location.origin}/?${aParametros(ultima.perfil)}` : location.origin;
				try {
					if (navigator.share && matchMedia('(pointer: coarse)').matches) {
						await navigator.share({ title: 'Ayudas para mi negocio', url });
						return;
					}
					await navigator.clipboard.writeText(url);
					compartir.textContent = 'Enlace copiado';
				} catch {
					compartir.textContent = 'No se ha podido copiar: usa la barra de direcciones';
				}
				setTimeout(() => (compartir.textContent = 'Copiar el enlace a estos resultados'), 2500);
			});

			// Al entrar: con respuestas en la dirección, sus ayudas; con ?empezar
			// (desde la ficha de una ayuda), las preguntas
			// Al recargar, arriba del todo: no a donde estaba (el contenido ya no es el mismo)
			history.scrollRestoration = 'manual';
			window.scrollTo({ top: 0, behavior: 'instant' });
			const entrada = new URLSearchParams(location.search);
			const desdeEnlace = deParametros(entrada);
			// Desde alertas.felixcorcoran.es se llega con #avisos: directo al recuadro
			const alAviso = location.hash === '#avisos';
			if (desdeEnlace) {
				// Se enseñan sus ayudas y la dirección queda limpia: al recargar, portada
				history.replaceState(null, '', '/');
				verAyudas(desdeEnlace, entrada.get('para')).then(() => {
					if (alAviso) setTimeout(() => avisos.scrollIntoView({ behavior: 'smooth', block: 'center' }), 400);
				});
			}
			else if (entrada.has('empezar')) {
				history.replaceState(null, '', '/');
				abrir();
			} else mirarGuardadas();
		</script>
</Base>

<style>
	/* main ocupa el alto que deja el pie; mientras solo está la portada, queda
	   centrada en ese hueco (los márgenes automáticos reparten el espacio por
	   igual arriba y abajo). Con preguntas o resultados, todo fluye normal. */
	main {
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		width: var(--frame);
		margin-inline: auto;
		/* Arriba, el mismo margen que el pie tiene encima de la firma: así el
		   hueco libre queda igual a los dos lados de la portada */
		padding: calc(var(--nav-top) + var(--nav-height) + clamp(0.75rem, 4svh, 3rem)) 0 0;
		flex: 1;
	}

	.intro:not(.empezada):has(~ .resultado[hidden]) {
		margin-block: auto;
	}

	/* Las preguntas grandes (comunidad y sector) y los resultados ocupan la
	   pantalla entera: el pie queda justo debajo, sin asomar. Las preguntas
	   cortas dejan ver el pie, como la portada */
	main:has(> :global(.asistente:not([hidden]) :is([data-paso='comunidad'], [data-paso='sector']):not([hidden]))),
	main:has(> .resultado:not([hidden])) {
		min-height: 100svh;
		padding-bottom: clamp(1.5rem, 4svh, 3rem);
	}

	.intro {
		max-width: 46rem;
	}

	h1 {
		margin: 0.75rem 0 1.25rem;
		font-size: clamp(2.1rem, 5.4vw, 3.75rem);
		font-weight: 400;
		line-height: 1.06;
		letter-spacing: -0.035em;
	}

	.lead {
