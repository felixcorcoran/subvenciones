---
/**
 * La ficha de cada convocatoria: lo que la IA ha sacado de sus bases, en
 * claro, con los enlaces oficiales. Una página por ayuda para que se pueda
 * encontrar en los buscadores y compartir.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import Cerrada from '../../components/Cerrada.astro';
import datos from '../../../datos/convocatorias.json';
import archivo from '../../../datos/cerradas.json';
import type { Cerrada as Retirada, Convocatoria, Datos } from '../../lib/tipos';
import { cierre, fechaLarga, municipioDe } from '../../lib/encaje';
import { enLista, estado, nombresCambios, origenCierre, plazoSinFecha, sinComprobarDesde, textoPlazo } from '../../lib/estado';
import { hoyMadrid } from '../../lib/fechas';
import { comunidadDe, deComunidad, indexable, porCierre, seccionesDe, SECTORES, titularDe } from '../../lib/lista';
import { aWeb } from '../../lib/web';
import { seccionDe } from '../../lib/sectores';
import { nombreZona } from '../../lib/zonas';
import { site } from '../../data/site';
import { nombreFinalidad } from '../../lib/finalidades';
import '../../styles/tarjetas.css';

// Las guardadas y, unos meses, las retiradas por cerradas (datos/cerradas.json):
// así un enlace compartido o de un buscador no acaba en un error
export const getStaticPaths = (() => {
	const { convocatorias } = datos as Datos;
	const guardadas = new Set(convocatorias.map((c) => c.codigo));
	return [
		...convocatorias.map((c) => ({ params: { codigo: c.codigo }, props: { c, retirada: null } })),
		...Object.values(archivo as Record<string, Retirada>)
			.filter((r) => !guardadas.has(r.codigo))
			.map((r) => ({ params: { codigo: r.codigo }, props: { c: null, retirada: r } })),
	];
}) satisfies GetStaticPaths;

const { retirada } = Astro.props as { retirada: Retirada | null };
// Una retirada se pinta con Cerrada.astro; lo de abajo se calcula con la primera
// guardada solo para no llenar la plantilla de comprobaciones, y no se usa
const c = (Astro.props.c ?? (datos as Datos).convocatorias[0]) as Convocatoria;
const ia = c.ia;
const fin = cierre(c);
const municipio = municipioDe(c);
const organo = [c.organo.nivel3, municipio ?? c.organo.nivel2].filter((v, i, a) => v && a.indexOf(v) === i).join(' · ');
const zonas = c.regiones.filter((r) => r.codigo.startsWith('ES')).map((r) => (r.codigo === 'ES' ? 'Toda España' : nombreZona(r.codigo, r.nombre)));
const secciones = [...new Set(c.sectores.map((s) => seccionDe(s.codigo)).filter((s): s is string => Boolean(s)))];
const sectores = secciones.length === 0 || secciones.length >= 8 ? 'Cualquier sector' : c.sectores.map((s) => s.nombre).join(', ');
const euros = (n: number) => n.toLocaleString('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
// En la cabecera, una cifra corta; el importe explicado va en su apartado
const importe = ia?.importeMaximo ? `Hasta ${euros(ia.importeMaximo)}` : c.presupuesto ? `Presupuesto total: ${euros(c.presupuesto)}` : null;
// La web se construye cada día con los datos: la fecha de construcción es «hoy»
const hoy = hoyMadrid();
const plazo = textoPlazo(c, hoy);
const porVerificar = estado(c, hoy) === 'por_verificar';
const previoCerrado = estado(c, hoy) === 'plazo_previo_cerrado';
// Si el cierre sale de las bases, las fechas de la ficha de la BDNS se enseñan aparte, sin decir de qué fase son
const fechasBdns =
	origenCierre(c) === 'bases' && (c.inicio || c.fin)
		? [c.inicio && `desde el ${fechaLarga(c.inicio)}`, c.fin && `hasta el ${fechaLarga(c.fin)}`].filter(Boolean).join(' ')
		: null;
const sinComprobar = sinComprobarDesde(c, hoy);
const ultimoCambio = c.cambios?.at(-1);

const titulo = titularDe(c);
const title = `${titulo.length > 70 ? `${titulo.slice(0, 67).trimEnd()}…` : titulo} · Radar de subvenciones`;
const description = [ia?.paraQuien, plazo, importe].filter(Boolean).join(' · ').slice(0, 300) || c.titulo;
// Fuera de los buscadores lo que no es una oportunidad clara: por verificar, plazo pasado, premios y otras
const noindex = !indexable(c, hoy);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'MonetaryGrant',
	name: titulo,
	alternateName: c.titulo,
	description: ia?.resumen ?? c.titulo,
	url: new URL(`/ayudas/${c.codigo}`, Astro.site).href,
	sameAs: c.enlace,
	identifier: c.codigo,
	funder: { '@type': 'GovernmentOrganization', name: c.organo.nivel3 || c.organo.nivel2 },
	...(zonas.length ? { areaServed: zonas.map((name) => ({ '@type': 'AdministrativeArea', name: name === 'toda España' || name === 'Toda España' ? 'España' : name })) } : {}),
	...(ia?.importeMaximo ? { amount: { '@type': 'MonetaryAmount', currency: 'EUR', maxValue: ia.importeMaximo } } : {}),
};

// Para «¿Puede pedirla tu negocio?» aquí mismo, con las respuestas guardadas en el navegador
const paraEncaje = JSON.stringify(aWeb(c)).replace(/</g, '\\u003c');

// Otras ayudas abiertas de su comunidad o, si es estatal, de su sector
const comunidad = comunidadDe(c);
const sectoresPropios = seccionesDe(c);
const sector = sectoresPropios.length === 1 ? SECTORES.find((s) => s.letra === sectoresPropios[0]) : undefined;
const abiertas = (datos as Datos).convocatorias.filter(
	(x) => x.codigo !== c.codigo && (!x.ia || x.ia.categoria === 'ayuda') && enLista(estado(x, hoy)),
);
const relacionadas = (
	comunidad
		? abiertas.filter((x) => deComunidad(x, comunidad.codigo))
		: sector
			? abiertas.filter((x) => seccionesDe(x).includes(sector.letra))
			: []
)
	.sort(porCierre)
	.slice(0, 4);
const masEn = comunidad
	? { texto: `Todas las de ${comunidad.nombre}`, href: `/comunidades/${comunidad.slug}`, titulo: `Otras ayudas en ${comunidad.nombre}` }
	: sector
		? { texto: `Todas las de ${sector.nombre.toLowerCase()}`, href: `/sectores/${sector.slug}`, titulo: 'Otras ayudas para el mismo sector' }
		: null;
const imagenOg = `/og/${c.codigo}.png`;
const enlaceFicha = new URL(`/ayudas/${c.codigo}`, Astro.site).href;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${titulo}\n${enlaceFicha}`)}`;
const finalidades = (ia?.finalidades ?? []).map(nombreFinalidad);
// El enlace para pedirla que dan las bases (comprobado al leerlas), si no es el mismo que la sede de la BDNS
const enlacePedir = ia?.enlaceSolicitud && ia.enlaceSolicitud !== c.sede ? ia.enlaceSolicitud : null;
// Avisar de un error en la ficha: un correo con el código y la dirección ya puestos
const avisarError = `mailto:${site.email}?subject=${encodeURIComponent(`Error en la ficha ${c.codigo}`)}&body=${encodeURIComponent(`Ficha: ${new URL(`/ayudas/${c.codigo}`, Astro.site).href}\n\nLo que está mal:\n`)}`;
---

{retirada ? <Cerrada r={retirada} /> : (
<Base title={title} description={description} jsonLd={jsonLd} noindex={noindex} imagen={imagenOg}>
	<main>
		<a class="volver" href="/">
			<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M10.5 6h-9M5 2.5 1.5 6 5 9.5"></path></svg>
			Todas las ayudas
		</a>

		<article>
			<p class="eyebrow">{organo}</p>
			<h1>{titulo}</h1>

			<ul class="datos">
				{plazo && <li class={previoCerrado ? 'sin-comprobar' : fin ? 'fecha' : ''}>{plazo}</li>}
				{!fin && plazoSinFecha(c) && <li class="sin-comprobar">Sin fecha de cierre confirmada</li>}
				{sinComprobar && <li class="sin-comprobar">Sin comprobar en la BDNS desde el {fechaLarga(sinComprobar)}</li>}
				{porVerificar && <li class="sin-comprobar">Registrada hace más de cuatro meses y sin fecha de cierre: puede que ya no esté abierta</li>}
				{importe && <li>{importe}</li>}
				{zonas.length > 0 && <li>{zonas.join(', ')}</li>}
			</ul>

			<div class="acciones">
				{
					fin && !previoCerrado && (
						<a class="boton" href={`/ayudas/${c.codigo}.ics`} download={`plazo-${c.codigo}.ics`}>
							Añadir el plazo al calendario
						</a>
					)
				}
				<a class="boton boton--claro" href="/?empezar" data-pedirla>¿Puede pedirla tu negocio?</a>
				<!-- Solo con JavaScript: se guarda en este navegador (portada, «Solo mis guardadas») -->
				<button type="button" class="boton boton--claro" data-guardar hidden aria-pressed="false">☆ Guardar</button>
			</div>
			<p class="compartir">
				Compartir: <a href={whatsapp} target="_blank" rel="noopener">WhatsApp ↗</a>
				<button type="button" class="compartir-copiar" data-copiar={enlaceFicha} hidden>Copiar el enlace</button>
			</p>

			<!-- Si ya respondió las preguntas en este navegador, el veredicto va aquí mismo -->
			<section id="veredicto" class="veredicto" hidden aria-live="polite">
				<h2>Con tus respuestas</h2>
				<p class="veredicto-titulo" data-titulo></p>
				<ul class="motivos" data-motivos></ul>
				<p class="veredicto-pie"><span data-negocio></span> · <a href="/?empezar">Cambiar respuestas</a></p>
			</section>
			<script type="application/json" id="ayuda-datos" set:html={paraEncaje} />

			{
				ia ? (
					<>
						<section>
							<h2>Para quién</h2>
							<p>{ia.paraQuien}</p>
							{finalidades.length > 0 && <p class="sirve">Sirve para: {finalidades.join(' · ')}</p>}
						</section>
						{ia.requisitos.length > 0 && (
							<section>
								<h2>Requisitos</h2>
								<ul>
									{ia.requisitos.map((r) => (
										<li>{r}</li>
									))}
								</ul>
							</section>
						)}
						{ia.gastos.length > 0 && (
							<section>
								<h2>En qué se puede gastar</h2>
								<ul>
									{ia.gastos.map((g) => (
										<li>{g}</li>
									))}
								</ul>
							</section>
						)}
						<section>
							<h2>Importe</h2>
							<p>{ia.importe}</p>
						</section>
						<section>
							<h2>Plazo</h2>
							<p>{c.iaRevisar ? 'El plazo ha cambiado en la convocatoria oficial y estamos volviendo a leer las bases. Mientras, mira la fecha de arriba y la convocatoria oficial.' : ia.plazo}</p>
						</section>
						{(ia.comoPedir?.length || ia.dondeSolicitar || enlacePedir) && (
							<section>
								<h2>Cómo se pide</h2>
								{ia.dondeSolicitar && <p>{ia.dondeSolicitar}</p>}
								{ia.comoPedir && ia.comoPedir.length > 0 && (
									<ol>
										{ia.comoPedir.map((x) => (
											<li>{x}</li>
										))}
									</ol>
								)}
								{enlacePedir && (
									<p class="pedir">
										<a href={enlacePedir} target="_blank" rel="noopener">
											Pedirla en línea (enlace de las bases) ↗
										</a>
									</p>
								)}
							</section>
						)}
						{ia.documentacion && ia.documentacion.length > 0 && (
							<section>
								<h2>Documentación que hay que presentar</h2>
								<ul>
									{ia.documentacion.map((x) => (
										<li>{x}</li>
									))}
								</ul>
							</section>
						)}
						{ia.dudas && (
							<section>
								<h2>Lo que no queda claro</h2>
								<p>{ia.dudas}</p>
							</section>
						)}
					</>
				) : (
					<section>
						<p>Aún no hemos leído sus bases. Mira los requisitos en la convocatoria oficial.</p>
					</section>
				)
			}

			<section>
				<h2>Datos de la convocatoria</h2>
				<dl>
					<dt>Título oficial</dt>
					<dd>{c.titulo}</dd>
					<dt>Convoca</dt>
					<dd>{[c.organo.nivel3, c.organo.nivel2].filter(Boolean).join(' — ')}</dd>
					<dt>Sector</dt>
					<dd>{sectores}</dd>
					{c.finalidad && <dt>Finalidad</dt>}
					{c.finalidad && <dd>{c.finalidad}</dd>}
					<dt>Código BDNS</dt>
					<dd>{c.codigo} · registrada el {fechaLarga(c.publicada)}</dd>
					{fechasBdns && <dt>Fechas en la ficha oficial (BDNS)</dt>}
					{fechasBdns && <dd>{fechasBdns.charAt(0).toUpperCase() + fechasBdns.slice(1)}</dd>}
					{c.comprobada && <dt>Comprobada en la BDNS</dt>}
					{c.comprobada && <dd>El {fechaLarga(c.comprobada)}</dd>}
					{ultimoCambio && <dt>Último cambio en la ficha</dt>}
					{ultimoCambio && <dd>El {fechaLarga(ultimoCambio.fecha)}: {nombresCambios(ultimoCambio.campos)}</dd>}
				</dl>
				<p class="enlaces">
					<a href={c.enlace} target="_blank" rel="noopener">Convocatoria oficial (BDNS) ↗</a>
					{c.bases && <a href={c.bases} target="_blank" rel="noopener">Bases ↗</a>}
					{c.sede && <a href={c.sede} target="_blank" rel="noopener">Dónde se solicita ↗</a>}
				</p>
			</section>

			{
				relacionadas.length > 0 && masEn && (
					<section class="relacionadas" aria-labelledby="relacionadas-titulo">
						<h2 id="relacionadas-titulo">{masEn.titulo}</h2>
						<ol class="lista">
							{relacionadas.map((x) => (
								<Tarjeta c={x} hoy={hoy} />
							))}
						</ol>
						<p class="mas-en">
							<a href={masEn.href}>{masEn.texto} →</a>
						</p>
					</section>
				)
			}

			<p class="nota">
				Resumen hecho con IA a partir de las bases de la convocatoria. Es una orientación: antes de pedirla, lee la convocatoria oficial, que es
				la que vale. ¿Ves algo mal? <a href={avisarError}>Avísanos</a>.
			</p>
		</article>
	</main>
</Base>
)}

<script>
	import { encaje, type Perfil } from '../../lib/encaje';
	import { hoyMadrid } from '../../lib/fechas';
	import type { ConvocatoriaWeb } from '../../lib/tipos';
	import { alternarGuardada, contarGuardada, guardadas } from '../../lib/visitas';

	const botonGuardar = document.querySelector<HTMLButtonElement>('[data-guardar]');
	const ayuda = JSON.parse(document.querySelector('#ayuda-datos')?.textContent || 'null') as ConvocatoriaWeb | null;
	const codigo = ayuda?.codigo;
	if (botonGuardar && ayuda && codigo) {
		const pintar = (si: boolean) => {
			botonGuardar.textContent = si ? '★ Guardada' : '☆ Guardar';
			botonGuardar.setAttribute('aria-pressed', String(si));
		};
		pintar(guardadas().has(codigo));
		botonGuardar.addEventListener('click', () => {
			const ahora = alternarGuardada(ayuda);
			pintar(ahora);
			if (ahora) contarGuardada(codigo);
		});
		botonGuardar.hidden = false;
	}

	// Copiar el enlace (en el móvil, el menú de compartir del sistema)
	const copiar = document.querySelector<HTMLButtonElement>('[data-copiar]');
	if (copiar) {
		const url = copiar.dataset.copiar!;
		const movil = Boolean(navigator.share) && matchMedia('(pointer: coarse)').matches;
		copiar.textContent = movil ? 'Más opciones' : 'Copiar el enlace';
		copiar.hidden = false;
		copiar.addEventListener('click', async () => {
			try {
				if (movil) return void (await navigator.share({ title: document.title, url }));
				await navigator.clipboard.writeText(url);
				copiar.textContent = 'Enlace copiado';
			} catch {
				copiar.textContent = 'No se ha podido: usa la barra de direcciones';
			}
			setTimeout(() => (copiar.textContent = movil ? 'Más opciones' : 'Copiar el enlace'), 2500);
		});
	}

	const TITULOS = { si: 'Puedes pedirla', revisa: 'Revisa los detalles: podría encajar', no: 'No encaja con tu negocio' };
	const caja = document.querySelector<HTMLElement>('#veredicto');
	const datosAyuda = document.querySelector('#ayuda-datos');
	let perfil: Perfil | null = null;
	try {
		perfil = JSON.parse(localStorage.getItem('perfil-subvenciones') ?? 'null') as Perfil | null;
	} catch {}
	// Respuestas guardadas por una versión anterior a la que le falte algo: se ignoran
	if (caja && datosAyuda && perfil?.provincia && perfil.forma && typeof perfil.municipio === 'string') {
		try {
			const c = JSON.parse(datosAyuda.textContent ?? '{}') as ConvocatoriaWeb;
			const e = encaje(c, perfil, hoyMadrid());
			caja.classList.add(`veredicto--${e.estado}`);
			caja.querySelector('[data-titulo]')!.textContent = TITULOS[e.estado];
			const lista = caja.querySelector('[data-motivos]')!;
			for (const m of e.motivos) {
				const li = document.createElement('li');
				li.className = `motivo motivo--${m.tipo}`;
				li.textContent = m.texto;
				lista.append(li);
			}
			caja.querySelector('[data-negocio]')!.textContent = 'Con lo que respondiste antes en este navegador';
			caja.hidden = false;
			// Ya no hace falta el botón que lleva a las preguntas
			document.querySelector<HTMLElement>('[data-pedirla]')?.remove();
		} catch {
			caja.hidden = true;
		}
	}
</script>

<style>
	.compartir {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1rem;
		margin: 1rem 0 0;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.compartir a,
	.compartir-copiar,
	.pedir a {
		padding: 0;
		border: 0;
		background: none;
		color: var(--text);
		font: inherit;
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 0.2em;
		cursor: pointer;
	}

	.compartir-copiar[hidden] {
		display: none;
	}

	.sirve {
		margin-top: 0.75rem !important;
		font-size: 0.9375rem !important;
		color: var(--text-muted);
	}

	section ol {
		margin: 0.5rem 0 0;
		padding-left: 1.4rem;
	}

	.pedir {
		margin-top: 0.75rem !important;
	}

	.veredicto {
		padding: clamp(1.125rem, 2.5vw, 1.5rem) clamp(1.125rem, 2.5vw, 1.75rem);
		border-radius: 1.25rem;
		background: rgb(var(--surface-rgb) / 0.75);
		border: 1px solid var(--rule);
		border-left: 3px solid var(--estado, var(--rule));
	}

	.veredicto[hidden] {
		display: none;
	}

	.veredicto--si {
		--estado: #3f8f5f;
	}

	.veredicto--revisa {
		--estado: #d49a2a;
	}

	.veredicto--no {
		--estado: rgb(var(--ink) / 0.25);
	}

	.veredicto-titulo {
		font-size: 1.125rem !important;
		font-weight: 500;
	}

	.veredicto .motivos {
		padding-left: 0;
	}

	.veredicto-pie {
		margin-top: 0.875rem !important;
		font-size: 0.875rem !important;
		color: var(--text-muted);
	}

	.veredicto-pie a,
	.mas-en a {
		color: var(--text);
		text-decoration-color: var(--accent);
		text-underline-offset: 0.2em;
	}

	.relacionadas .lista {
		padding-left: 0;
	}

	.relacionadas .ayuda-datos {
		padding-left: 0;
	}

	.mas-en {
		margin-top: 1rem !important;
		font-size: 0.9375rem;
	}

	main {
		box-sizing: border-box;
		width: var(--frame);
		margin-inline: auto;
		padding: calc(var(--nav-top) + var(--nav-height) + clamp(2rem, 6vw, 4rem)) 0 clamp(3rem, 8vw, 6rem);
		flex: 1;
	}

	article {
		max-width: 46rem;
	}

	.volver {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
		font-size: 0.875rem;
		color: var(--text-muted);
		text-decoration: none;
	}

	.volver:hover {
		color: var(--text);
	}

	.volver svg {
		width: 0.75rem;
		height: 0.75rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	h1 {
		margin: 0.75rem 0 0;
		font-size: clamp(1.5rem, 3.2vw, 2.25rem);
		font-weight: 400;
		line-height: 1.12;
		letter-spacing: -0.03em;
	}

	.datos {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.datos li {
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		background: rgb(var(--ink) / 0.05);
		font-size: 0.875rem;
	}

	.datos li.fecha {
		background: var(--accent-soft);
	}

	.datos li.sin-comprobar {
		background: none;
		box-shadow: inset 0 0 0 1px rgb(var(--ink) / 0.18);
		color: var(--text-muted);
	}

